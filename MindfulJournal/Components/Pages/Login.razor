@page "/login"
@rendermode InteractiveServer
@layout MindfulJournal.Components.Layout.AuthLayout
@inject NavigationManager Navigation

<div class="auth-wrapper">
    <div class="auth-box">
        <div class="auth-title">🧘 Mindful Journal</div>
        <div class="auth-subtitle">Welcome back</div>

        @if (showError)
        {
            <div class="error-message">
                Invalid email or password. Please try again.
            </div>
        }

        <form method="post" action="/LoginHandler">
            <div class="form-group">
                <label>Email</label>
                <input name="email" type="email"
                       placeholder="jane@email.com" required />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input name="password" type="password"
                       placeholder="••••••" required />
            </div>

            <button type="submit" class="btn-primary">
                Sign In
            </button>
        </form>

        <div class="auth-link">
            Don't have an account? <a href="/register">Sign up</a>
        </div>
    </div>
</div>

@code {
    bool showError = false;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        showError = query["error"] == "invalid";
    }
}