@page "/admin/entries"
@rendermode InteractiveServer
@layout MindfulJournal.Components.Layout.AdminLayout
@inject MindfulJournal.Services.AdminService AdminService
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<PageTitle>All Entries - Admin</PageTitle>

<h2 style="font-size:22px; font-weight:700;
    color:rgba(255,255,255,0.9); margin-bottom:20px;">
    📝 All Journal Entries
</h2>

<div style="background:rgba(255,255,255,0.04);
    backdrop-filter:blur(16px);
    border:1px solid rgba(255,255,255,0.08);
    border-radius:16px; padding:22px;">

    <div style="display:flex; gap:12px; margin-bottom:20px; flex-wrap:wrap;">
        <input type="text"
               @oninput="@(e => { searchText = e.Value?.ToString() ?? ""; ApplyFilter(); })"
               placeholder="🔍 Search by title, content or user..."
               style="flex:1; min-width:200px; padding:9px 14px;
        background:rgba(255,255,255,0.06);
        border:1px solid rgba(255,255,255,0.1);
        border-radius:8px; color:rgba(255,255,255,0.9);
        font-family:'Plus Jakarta Sans',sans-serif;
        font-size:13px; outline:none;" />

        <select @bind="moodFilter" @bind:after="ApplyFilter"
                style="padding:9px 14px;
            background:rgba(255,255,255,0.06);
            border:1px solid rgba(255,255,255,0.1);
            border-radius:8px; color:rgba(255,255,255,0.9);
            font-family:'Plus Jakarta Sans',sans-serif;
            font-size:13px; outline:none;">
            <option value="">All Moods</option>
            <option value="Happy">😄 Happy</option>
            <option value="Sad">😢 Sad</option>
            <option value="Stressed">😫 Stressed</option>
            <option value="Angry">😡 Angry</option>
            <option value="Neutral">😐 Neutral</option>
            <option value="Calm">😌 Calm</option>
            <option value="Anxious">😰 Anxious</option>
        </select>
    </div>

    <div style="font-size:12px; color:rgba(255,255,255,0.3);
        margin-bottom:12px;">
        Showing @filteredEntries.Count of @allEntries.Count entries
    </div>

    @if (isLoading)
    {
        <div style="text-align:center; padding:40px;
            color:rgba(255,255,255,0.4);">
            Loading entries...
        </div>
    }
    else if (filteredEntries.Count == 0)
    {
        <div style="text-align:center; padding:40px;
            color:rgba(255,255,255,0.3);">
            No entries found.
        </div>
    }
    else
    {
        @for (int i = 0; i < filteredEntries.Count; i++)
        {
            var entry = filteredEntries[i];
            var eid = entry.EntryId;

            <div style="display:flex; justify-content:space-between;
                align-items:flex-start; padding:14px;
                border:1px solid rgba(255,255,255,0.06);
                border-radius:10px; margin-bottom:8px;
                background:rgba(255,255,255,0.03);
                transition:all 0.2s;">
                <div style="flex:1;">
                    <div style="display:flex; align-items:center;
                        gap:10px; margin-bottom:4px;">
                        <span style="font-size:14px; font-weight:700;
                            color:rgba(255,255,255,0.9);">
                            @entry.Title
                        </span>
                        <span style="font-size:11px; padding:3px 10px;
                            background:rgba(0,212,255,0.1);
                            color:#00D4FF; border-radius:20px;
                            border:1px solid rgba(0,212,255,0.2);">
                            @entry.Mood
                        </span>
                    </div>
                    <div style="font-size:12px;
                        color:rgba(255,255,255,0.35);
                        margin-bottom:4px;">
                        👤 @entry.UserName •
                        📅 @entry.EntryDate.ToString("MMM dd, yyyy")
                    </div>
                    <div style="font-size:13px;
                        color:rgba(255,255,255,0.5);
                        line-height:1.4;">
                        @(entry.Content.Length > 100
                            ? entry.Content.Substring(0, 100) + "..."
                            : entry.Content)
                    </div>
                </div>
                <button @onclick="@(() => DeleteEntry(eid))"
                        style="margin-left:12px; padding:7px 14px;
                    background:rgba(244,67,54,0.1);
                    color:#EF9A9A;
                    border:1px solid rgba(244,67,54,0.2);
                    border-radius:6px; cursor:pointer;
                    font-size:12px; font-weight:700;
                    font-family:'Plus Jakarta Sans',sans-serif;
                    flex-shrink:0; transition:all 0.2s;">
                    🗑️ Delete
                </button>
            </div>
        }
    }
</div>

@code {
    List<JournalEntry> allEntries = new();
    List<JournalEntry> filteredEntries = new();
    string searchText = "";
    string moodFilter = "";
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
    }

    async Task LoadEntries()
    {
        isLoading = true;
        StateHasChanged();
        allEntries = await AdminService.GetAllEntriesAsync();
        ApplyFilter();
        isLoading = false;
        StateHasChanged();
    }

    void ApplyFilter()
    {
        filteredEntries = allEntries.Where(e =>
            (string.IsNullOrEmpty(searchText) ||
             e.Title.Contains(searchText,
                 StringComparison.OrdinalIgnoreCase) ||
             e.Content.Contains(searchText,
                 StringComparison.OrdinalIgnoreCase) ||
             e.UserName.Contains(searchText,
                 StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(moodFilter) ||
             e.Mood == moodFilter)
        ).ToList();
        StateHasChanged();
    }

    async Task DeleteEntry(int entryId)
    {
        await AdminService.DeleteEntryAsync(entryId);
        await LoadEntries();
    }
}