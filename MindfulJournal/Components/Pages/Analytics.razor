@page "/analytics"
@rendermode InteractiveServer
@attribute [Authorize]
@layout MindfulJournal.Components.Layout.MainLayout
@inject AuthenticationStateProvider AuthStateProvider
@inject MindfulJournal.Services.JournalService JournalService
@inject IJSRuntime JS

<PageTitle>Analytics - Mindful Journal</PageTitle>

<h2 style="font-size:22px; font-weight:700; color:#333; margin-bottom:20px;">
    📊 Mood Analytics
</h2>

<!-- Stats Cards -->
<div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:24px;">
    <div class="card" style="text-align:center;">
        <div style="font-size:32px; margin-bottom:8px;">📝</div>
        <div style="font-size:28px; font-weight:700; color:#4DB6AC;">
            @totalEntries
        </div>
        <div style="font-size:13px; color:#888;">Total Entries</div>
    </div>
    <div class="card" style="text-align:center;">
        <div style="font-size:32px; margin-bottom:8px;">😊</div>
        <div style="font-size:28px; font-weight:700; color:#4DB6AC;">
            @mostCommonMood
        </div>
        <div style="font-size:13px; color:#888;">Most Common Mood</div>
    </div>
    <div class="card" style="text-align:center;">
        <div style="font-size:32px; margin-bottom:8px;">🔥</div>
        <div style="font-size:28px; font-weight:700; color:#4DB6AC;">
            @currentStreak days
        </div>
        <div style="font-size:13px; color:#888;">Current Streak</div>
    </div>
</div>

<!-- Charts Row -->
<div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px;">
    <div class="card">
        <div class="card-title">Mood Distribution (This Month)</div>
        <canvas id="analyticsPie" width="300" height="300"></canvas>
    </div>
    <div class="card">
        <div class="card-title">Weekly Emotional Trend</div>
        <canvas id="analyticsLine" width="300" height="300"></canvas>
    </div>
</div>

<!-- Mood Breakdown -->
<div class="card">
    <div class="card-title">Mood Breakdown</div>
    @foreach (var mood in monthlyMoods)
    {
        var percentage = totalEntries > 0
            ? (int)((mood.Value / (double)totalEntries) * 100) : 0;
        <div style="margin-bottom:14px;">
            <div style="display:flex; justify-content:space-between;
                font-size:13px; margin-bottom:4px;">
                <span>@GetMoodEmoji(mood.Key) @mood.Key</span>
                <span style="font-weight:600; color:#4DB6AC;">
                    @mood.Value entries (@percentage%)
                </span>
            </div>
            <div style="background:#f0f0f0; border-radius:20px; height:8px;">
                <div style="background:#4DB6AC; border-radius:20px;
                    height:8px; width:@(percentage)%;">
                </div>
            </div>
        </div>
    }
    @if (monthlyMoods.Count == 0)
    {
        <p style="color:#aaa; text-align:center; padding:20px;">
            No entries this month yet.
        </p>
    }
</div>

@code {
    string userId = "";
    int totalEntries = 0;
    string mostCommonMood = "None";
    int currentStreak = 0;
    Dictionary<string, int> monthlyMoods = new();
    Dictionary<string, int> weeklyMoods = new();
    bool dataLoaded = false;
    bool chartsDrawn = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        totalEntries = await JournalService.GetTotalEntriesAsync(userId);
        mostCommonMood = await JournalService.GetMostCommonMoodAsync(userId);
        monthlyMoods = await JournalService.GetMonthlyMoodCountsAsync(userId);
        weeklyMoods = await JournalService.GetWeeklyMoodCountsAsync(userId);
        currentStreak = await JournalService.GetStreakAsync(userId);
        dataLoaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (dataLoaded && !chartsDrawn)
        {
            chartsDrawn = true;
            await Task.Delay(100); // wait for canvas to render
            await RenderCharts();
        }
    }

    async Task RenderCharts()
    {
        var moodColors = new Dictionary<string, string>
        {
            {"Happy","#4CAF50"}, {"Sad","#2196F3"},
            {"Stressed","#FF9800"}, {"Angry","#F44336"},
            {"Neutral","#9E9E9E"}, {"Calm","#00BCD4"},
            {"Anxious","#9C27B0"}
        };

        // Pie chart
        var pieData = monthlyMoods.Count > 0
            ? monthlyMoods
            : new Dictionary<string, int> { { "No Data", 1 } };

        var labels = pieData.Keys.ToArray();
        var values = pieData.Values.ToArray();
        var colors = labels.Select(l =>
            moodColors.ContainsKey(l) ? moodColors[l] : "#ccc").ToArray();

        await JS.InvokeVoidAsync("renderPieChart",
            "analyticsPie", labels, values, colors);

        // Line chart — all moods
        var weekLabels = new[]
            { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };

        var datasets = new List<object>();
        foreach (var mood in weeklyMoods)
        {
            var color = moodColors.ContainsKey(mood.Key)
                ? moodColors[mood.Key] : "#ccc";
            var data = new int[7];
            for (int i = 0; i < 7; i++)
                data[i] = i == 6 ? mood.Value : 0;

            datasets.Add(new
            {
                label = mood.Key,
                data = data,
                borderColor = color,
                backgroundColor = color + "22",
                tension = 0.4,
                fill = false
            });
        }

        await JS.InvokeVoidAsync("renderLineChart",
            "analyticsLine", weekLabels, datasets);
    }

    string GetMoodEmoji(string mood) => mood switch
    {
        "Happy" => "😄",
        "Sad" => "😢",
        "Stressed" => "😫",
        "Angry" => "😡",
        "Neutral" => "😐",
        "Calm" => "😌",
        "Anxious" => "😰",
        _ => "😐"
    };
}