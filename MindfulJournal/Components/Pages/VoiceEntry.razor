@page "/voice-entry"
@rendermode InteractiveServer
@attribute [Authorize]
@layout MindfulJournal.Components.Layout.MainLayout
@inject AuthenticationStateProvider AuthStateProvider
@inject MindfulJournal.Services.JournalService JournalService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Voice Entry - Mindful Journal</PageTitle>

<div style="max-width:700px;">
    <h2 style="font-size:22px; font-weight:700;
        color:rgba(255,255,255,0.9); margin-bottom:20px;">
        🎤 Voice Journal Entry
    </h2>

    @if (!isSpeechSupported)
    {
        <div class="error-message">
            ⚠️ Your browser does not support voice recognition.
            Please use Google Chrome for this feature.
        </div>
    }

    <div class="card" style="margin-bottom:20px;">
        <div class="card-title">Speak Your Journal</div>

        <div style="text-align:center; padding:30px 20px;">
            <button @onclick="ToggleRecording"
                    disabled="@(!isSpeechSupported)"
                    style="width:110px; height:110px;
                border-radius:50%;
                background:@(isRecording
                                                   ? "rgba(244,67,54,0.2)"
                                                   : "rgba(77,182,172,0.15)");
                border:2px solid @(isRecording
                                                   ? "rgba(244,67,54,0.6)"
                                                   : "rgba(77,182,172,0.5)");
                cursor:pointer; font-size:40px;
                transition:all 0.3s;
                box-shadow:@(isRecording
                                                   ? "0 0 30px rgba(244,67,54,0.3)"
                                                   : "0 0 20px rgba(77,182,172,0.2)");">
                @(isRecording ? "⏹️" : "🎤")
            </button>

            <div style="margin-top:16px; font-size:14px;
                color:rgba(255,255,255,0.5);">
                @statusMessage
            </div>

            @if (isRecording)
            {
                <div style="display:flex; align-items:center;
                    justify-content:center; gap:6px;
                    margin-top:10px;">
                    <div style="width:8px; height:8px; border-radius:50%;
                        background:#EF5350;
                        animation:pulse-ring 1s ease infinite;">
                    </div>
                    <span style="font-size:12px; color:#EF9A9A;
                        font-weight:700; letter-spacing:1px;">
                        RECORDING
                    </span>
                </div>
            }
        </div>

        <div class="form-group">
            <label>Transcribed Text</label>
            <textarea @bind="transcribedText" rows="6"
                      placeholder="Your speech will appear here as you speak..."
                      style="width:100%; padding:12px 14px;
            background:rgba(255,255,255,0.06);
            border:1px solid rgba(255,255,255,0.1);
            border-radius:10px;
            color:rgba(255,255,255,0.9);
            font-family:'Plus Jakarta Sans',sans-serif;
            font-size:14px; resize:vertical;
            outline:none; line-height:1.6;">
        </textarea>
    </div>

    <div class="form-group">
        <label>Current Mood</label>
        <div class="mood-selector">
            @foreach (var mood in moods)
            {
                var m = mood;
                <div class="mood-btn @(selectedMood == m.Name ? "selected" : "")"
                     @onclick="@(() => selectedMood = m.Name)">
                    <span class="mood-emoji">@m.Emoji</span>
                    <span class="mood-label">@m.Name</span>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert-success">@successMessage</div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-message">@errorMessage</div>
    }

    <div style="display:flex; gap:12px; margin-top:8px;">
        <button class="btn-primary" style="flex:1;"
                @onclick="SaveVoiceEntry"
                disabled="@(string.IsNullOrWhiteSpace(transcribedText) || isSaving)">
            @(isSaving ? "Saving..." : "💾 Save Entry")
        </button>
        <button @onclick="ClearText"
                style="flex:1; padding:12px; cursor:pointer;
            background:rgba(255,255,255,0.05);
            border:1px solid rgba(255,255,255,0.1);
            border-radius:10px; color:rgba(255,255,255,0.5);
            font-family:'Plus Jakarta Sans',sans-serif;
            font-size:14px; font-weight:600;">
            🗑️ Clear
        </button>
    </div>
</div>
</div>

@code {
    string userId = "";
    string transcribedText = "";
    string selectedMood = "Happy";
    string successMessage = "";
    string errorMessage = "";
    string statusMessage = "Click mic to start recording";
    bool isRecording = false;
    bool isSpeechSupported = true;
    bool isSaving = false;

    List<(string Name, string Emoji)> moods = new()
    {
        ("Happy","😄"), ("Sad","😢"), ("Stressed","😫"),
        ("Angry","😡"), ("Neutral","😐"), ("Calm","😌"), ("Anxious","😰")
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isSpeechSupported = await JS.InvokeAsync<bool>(
                "checkSpeechSupport");
            if (!isSpeechSupported)
                statusMessage = "Voice not supported in this browser";
            else
                await JS.InvokeVoidAsync("initSpeechRecognition",
                    DotNetObjectReference.Create(this));
            StateHasChanged();
        }
    }

    async Task ToggleRecording()
    {
        if (!isSpeechSupported) return;

        isRecording = !isRecording;
        if (isRecording)
        {
            statusMessage = "Listening... Speak now";
            await JS.InvokeVoidAsync("startRecording");
        }
        else
        {
            statusMessage = "Recording stopped";
            await JS.InvokeVoidAsync("stopRecording");
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void UpdateTranscript(string text)
    {
        transcribedText += (string.IsNullOrEmpty(transcribedText) ? "" : " ") + text;
        StateHasChanged();
    }

    [JSInvokable]
    public void StopRecordingCallback()
    {
        isRecording = false;
        statusMessage = "Recording stopped. Review and save your entry.";
        StateHasChanged();
    }

    async Task SaveVoiceEntry()
    {
        if (string.IsNullOrWhiteSpace(transcribedText)) return;

        isSaving = true;
        StateHasChanged();

        var entry = new MindfulJournal.Models.JournalEntry
        {
            UserId = userId,
            Title = $"Voice Entry - {DateTime.Today:MMM dd}",
            Content = transcribedText.Trim(),
            Mood = selectedMood,
            EntryDate = DateTime.Today,
            CreatedAt = DateTime.Now
        };

        await JournalService.AddEntryAsync(entry);
        successMessage = "Voice entry saved successfully! ✅";
        isSaving = false;
        StateHasChanged();

        await Task.Delay(2000);
        Navigation.NavigateTo("/view-entries");
    }

    void ClearText()
    {
        transcribedText = "";
        statusMessage = "Click mic to start recording";
        StateHasChanged();
    }
}