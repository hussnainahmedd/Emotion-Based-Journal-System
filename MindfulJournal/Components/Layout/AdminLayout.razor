@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@implements IAsyncDisposable

<!-- Vanta NET Background -->
<div id="admin-vanta-bg"
     style="position:fixed; inset:0; z-index:0; width:100%; height:100%;">
</div>

<!-- Dark overlay -->
<div style="position:fixed; inset:0; z-index:1; pointer-events:none;
    background:linear-gradient(135deg,
    rgba(2,11,24,0.75) 0%,
    rgba(5,15,30,0.70) 50%,
    rgba(2,11,24,0.75) 100%);">
</div>

<!-- Main wrapper -->
<div style="position:relative; z-index:2; display:flex; min-height:100vh;">

    <!-- Sidebar -->
    <div style="width:230px; position:fixed; height:100vh; z-index:100;
        background:rgba(2,11,24,0.80);
        backdrop-filter:blur(24px);
        -webkit-backdrop-filter:blur(24px);
        border-right:1px solid rgba(0,212,255,0.15);
        box-shadow:4px 0 30px rgba(0,0,0,0.5);
        display:flex; flex-direction:column;">

        <!-- Logo -->
        <div style="padding:22px 20px;
            border-bottom:1px solid rgba(0,212,255,0.1);
            position:relative; overflow:hidden;">
            <div style="font-size:16px; font-weight:800;
                background:linear-gradient(90deg,#00D4FF,#4DB6AC);
                -webkit-background-clip:text;
                -webkit-text-fill-color:transparent;
                letter-spacing:0.5px; position:relative; z-index:1;">
                🛡️ Admin Panel
            </div>
            <div style="font-size:11px; color:rgba(0,212,255,0.4);
                margin-top:4px; letter-spacing:1px;
                text-transform:uppercase; position:relative; z-index:1;">
                System Control
            </div>
        </div>

        <!-- Nav Links -->
        <nav style="display:flex; flex-direction:column;
            padding:14px 10px; gap:3px; flex:1;">

            <a href="/admin" style="@NavStyle("/admin", true)">
                <span style="font-size:16px;">📊</span>
                <span>Dashboard</span>
            </a>
            <a href="/admin/users" style="@NavStyle("/admin/users")">
                <span style="font-size:16px;">👥</span>
                <span>Users</span>
            </a>
            <a href="/admin/entries" style="@NavStyle("/admin/entries")">
                <span style="font-size:16px;">📝</span>
                <span>Entries</span>
            </a>
            <a href="/admin/feedback" style="@NavStyle("/admin/feedback")">
                <span style="font-size:16px;">💬</span>
                <span>Feedback</span>
            </a>

            <div style="margin-top:auto; padding-top:16px;
                border-top:1px solid rgba(0,212,255,0.08);">
                <a href="/dashboard"
                   style="display:flex; align-items:center; gap:10px;
                    padding:11px 14px; color:rgba(255,255,255,0.35);
                    text-decoration:none; font-size:13px;
                    border-radius:10px; transition:all 0.2s;
                    font-family:'Plus Jakarta Sans',sans-serif;">
                    <span style="font-size:16px;">🏠</span>
                    <span>Back to App</span>
                </a>
            </div>
        </nav>
    </div>

    <!-- Main Content -->
    <div style="margin-left:230px; flex:1; display:flex; flex-direction:column;">

        <!-- Topbar -->
        <div style="position:sticky; top:0; z-index:50;
            background:rgba(2,11,24,0.80);
            backdrop-filter:blur(24px);
            -webkit-backdrop-filter:blur(24px);
            border-bottom:1px solid rgba(0,212,255,0.1);
            padding:14px 28px;
            display:flex; justify-content:space-between;
            align-items:center;
            box-shadow:0 2px 20px rgba(0,0,0,0.4);">

            <div style="display:flex; align-items:center; gap:10px;">
                <div style="width:8px; height:8px; border-radius:50%;
                    background:#00D4FF;
                    box-shadow:0 0 10px #00D4FF;
                    animation:pulse-ring 2s ease infinite;">
                </div>
                <span style="font-size:12px; font-weight:700;
                    color:rgba(0,212,255,0.7);
                    text-transform:uppercase; letter-spacing:1px;">
                    System Online
                </span>
            </div>

            <div style="display:flex; align-items:center; gap:14px;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <div style="width:32px; height:32px; border-radius:50%;
                        background:linear-gradient(135deg,
                        rgba(0,212,255,0.3),
                        rgba(77,182,172,0.3));
                        border:1.5px solid rgba(0,212,255,0.4);
                        display:flex; align-items:center;
                        justify-content:center; font-size:14px;">
                        🛡️
                    </div>
                    <span style="font-size:13px; font-weight:700;
                        color:rgba(255,255,255,0.8);">
                        Administrator
                    </span>
                </div>
                <form method="post" action="/logout">
                    <button type="submit"
                            style="padding:7px 16px;
                        border:1px solid rgba(0,212,255,0.3);
                        background:rgba(0,212,255,0.08);
                        border-radius:8px; cursor:pointer;
                        font-size:12px; font-weight:700;
                        color:rgba(0,212,255,0.8);
                        font-family:'Plus Jakarta Sans',sans-serif;
                        transition:all 0.2s;
                        letter-spacing:0.3px;">
                        Logout
                    </button>
                </form>
            </div>
        </div>

        <!-- Page Content -->
        <div style="padding:28px; flex:1;">
            @Body
        </div>
    </div>
</div>

@code {
    private bool _initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            try
            {
                await Task.Delay(300);
                await JS.InvokeVoidAsync("initVantaNet", "admin-vanta-bg");
            }
            catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("destroyVantaNet"); }
        catch { }
    }

    string NavStyle(string path, bool exact = false)
    {
        bool active = exact
            ? Navigation.Uri.EndsWith("/admin") ||
              Navigation.Uri.EndsWith("/admin/")
            : Navigation.Uri.Contains(path);

        return $@"display:flex; align-items:center; gap:10px;
                  padding:11px 14px; text-decoration:none;
                  font-size:13.5px; font-weight:{(active ? "700" : "500")};
                  border-radius:10px; transition:all 0.2s;
                  color:{(active ? "#00D4FF" : "rgba(255,255,255,0.4)")};
                  background:{(active
                      ? "rgba(0,212,255,0.12)"
                      : "transparent")};
                  border-left:{(active
                      ? "3px solid #00D4FF"
                      : "3px solid transparent")};
                  font-family:'Plus Jakarta Sans',sans-serif;";
    }
}